# ─────────────────────────────────────────────────────────────
#  FAAPS Mobile — runtime configuration (template)
# ─────────────────────────────────────────────────────────────
#  Copy to `.env` (or `.env.local`) and fill in your own values.
#  `.env.local` is git-ignored, which is the right place for a
#  machine-specific LAN address.
#
#  Every variable here is inlined into the JS bundle at build time
#  by the Expo CLI, so never put a secret in an EXPO_PUBLIC_* var.
# ─────────────────────────────────────────────────────────────

# Base URL of the FAAPS backend.
#
# The trailing `/api` is optional — `src/config/api.ts` strips it,
# because every service path in `src/lib/api/*` already starts
# with `/api` (e.g. `/api/student/profile`).
#
#   Physical device  →  http://<your-lan-ip>:8080
#   Android emulator →  http://10.0.2.2:8080
#   iOS simulator    →  http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.219:8080/api
